# GAME STUDIO — configurazione locale. Copia questo file in .env (nella cartella dello Studio) e compila solo quello che ti serve.

# ── Il gioco ────────────────────────────────────────────────────────────────────────────
# Cartella del gioco su cui lavora lo Studio. Predefinita: la cartella tq-evs accanto a questa.
# STUDIO_PROJECT_ROOT=/Users/tuonome/Downloads/tq-evs
# .env NON va in git (è in .gitignore). Dopo una modifica: ./stop-studio.sh && ./start-studio.sh

# ── Provider testo/codice ────────────────────────────────────────────────────────────────
# Predefinito: Claude Code (il comando `claude` già installato e autenticato sul Mac). Nessuna chiave necessaria.
# Se `claude` non è nel PATH dello Studio, indica il percorso completo (lo trovi con: which claude)
# CLAUDE_CODE_BIN=/Users/tuonome/.local/bin/claude

# ChatGPT / Codex (CLI di OpenAI, login col tuo account ChatGPT: npm i -g @openai/codex && codex login)
# CODEX_BIN=/opt/homebrew/bin/codex

# In alternativa (o in aggiunta): API Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Provider immagini (Cosetta) ──────────────────────────────────────────────────────────
# GPT Image 2 (OpenAI) — chiave da https://platform.openai.com/api-keys (a consumo, separata da ChatGPT Plus)
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-2
# Nano Banana (Google Gemini) — chiave da https://aistudio.google.com/apikey (c'è una quota gratuita)
# GEMINI_API_KEY=...
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image      # Nano Banana 2; per il Pro: gemini-3-pro-image

# ── Gemini come agente (testo/codice) ────────────────────────────────────────────────────
# npm i -g @google/gemini-cli, poi lancia una volta `gemini` e fai il login con Google (oppure usa GEMINI_API_KEY)
# GEMINI_BIN=/opt/homebrew/bin/gemini

# ── Studio ───────────────────────────────────────────────────────────────────────────────
# STUDIO_PORT=4173
# STUDIO_HOST=127.0.0.1        # 0.0.0.0 per aprirlo da altri dispositivi della rete di casa
